<%- include('partials/header', { title: complaint.complaintId || complaint.title }) %>
<% const student = complaint.studentId; %>
<% const photos = complaint.images.length ? complaint.images : (complaint.image ? [complaint.image] : []); %>
<% const fmt = (d) => d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }); %>

<p><a href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>">‹ Back to complaints</a></p>

<div class="card">
  <div class="row between">
    <div>
      <span class="cid"><%= complaint.complaintId %></span>
      <h1><%= complaint.title %></h1>
    </div>
    <div class="tags">
      <span class="prio prio-<%= complaint.priority %>"><%= complaint.priority %> priority</span>
      <span class="badge s-<%= complaint.status.replace(' ', '') %>"><%= complaint.status %></span>
    </div>
  </div>

  <dl class="facts">
    <div><dt>Category</dt><dd><%= complaint.category %></dd></div>
    <div><dt>Issue</dt><dd><%= complaint.issue || '-' %></dd></div>
    <div><dt>Location</dt><dd><%= complaint.hostel %>, Room <%= complaint.roomNo || '-' %></dd></div>
    <div><dt>Filed</dt><dd><%= fmt(complaint.createdAt) %></dd></div>
    <div><dt>Assigned staff</dt><dd><%= complaint.assignedTo || 'Not assigned yet' %></dd></div>
    <% if (complaint.resolvedAt) { %>
      <div><dt>Resolved</dt><dd><%= fmt(complaint.resolvedAt) %>
        <span class="muted">(<%= ((complaint.resolvedAt - complaint.createdAt) / 36e5).toFixed(1) %> h)</span></dd></div>
    <% } %>
    <% Object.entries(complaint.extraDetails || {}).forEach(([k, v]) => { %>
      <div><dt><%= (Object.values(EXTRA_FIELDS).find(x => x.key === k) || { label: k }).label %></dt><dd><%= v %></dd></div>
    <% }) %>
  </dl>

  <p class="description"><%= complaint.description %></p>

  <% if (photos.length) { %>
    <div class="gallery">
      <% photos.forEach((p, i) => { %><a href="<%= p %>" target="_blank" rel="noopener"><img class="photo" src="<%= p %>" alt="Complaint photo <%= i + 1 %>"></a><% }) %>
    </div>
  <% } %>
</div>

<% if (user.role === 'admin') { %>
<div class="grid2">
  <div class="card">
    <h2>Student</h2>
    <% if (student) { %>
      <dl class="facts one">
        <div><dt>Name</dt><dd><%= student.name %></dd></div>
        <div><dt>Email</dt><dd><a href="mailto:<%= student.email %>"><%= student.email %></a></dd></div>
        <div><dt>Hostel / room</dt><dd><%= student.hostel %>, Room <%= student.roomNo || '-' %></dd></div>
      </dl>
      <a href="/admin?student=<%= student._id %>">All complaints by this student</a>
    <% } else { %>
      <p class="muted">This student account has been deleted.</p>
    <% } %>
  </div>

  <div class="card">
    <h2>Manage complaint</h2>
    <form method="POST" action="/admin/complaints/<%= complaint._id %>/status">
      <div class="grid-form">
        <label>Status
          <select name="status">
            <% STATUSES.forEach(s => { %><option <%= complaint.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
        </label>
        <label>Priority
          <select name="priority">
            <% PRIORITIES.forEach(p => { %><option <%= complaint.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
          </select>
        </label>
      </div>
      <label>Assign staff <input type="text" name="assignedTo" maxlength="60" value="<%= complaint.assignedTo || '' %>" placeholder="e.g. Ramesh (electrician)"></label>
      <label>Comment for the student <span class="muted">(optional)</span>
        <textarea name="note" rows="2" maxlength="500" placeholder="Electrician will visit tomorrow morning"></textarea>
      </label>
      <button class="btn" type="submit" data-busy="Updating…">Update complaint</button>
    </form>
  </div>
</div>
<% } %>

<div class="card">
  <h2>Status timeline</h2>
  <ol class="timeline">
    <% complaint.statusHistory.forEach(h => { %>
      <li class="t-<%= h.status.replace(' ', '') %>">
        <strong><%= h.status %></strong>
        <span class="muted"><%= fmt(h.at) %><%= h.by ? ' · ' + h.by : '' %></span>
      </li>
    <% }) %>
  </ol>
</div>

<div class="card" id="comments">
  <h2>Comments</h2>
  <% if (complaint.comments.length === 0) { %><p class="muted">No comments yet.</p><% } %>
  <% complaint.comments.forEach(c => { %>
    <div class="comment <%= c.role === 'admin' ? 'by-admin' : '' %>">
      <strong><%= c.by %></strong> <span class="muted"><%= c.role === 'admin' ? '(hostel office)' : '' %> <%= fmt(c.at) %></span>
      <p><%= c.text %></p>
    </div>
  <% }) %>
  <form class="inline" method="POST" action="/complaints/<%= complaint._id %>/comment">
    <input type="text" name="text" maxlength="500" placeholder="Write a comment" required aria-label="Comment">
    <button class="btn" type="submit" data-busy="Posting…">Post comment</button>
  </form>
</div>

<% if (user.role === 'student' && complaint.status === 'Pending') { %>
  <div class="row">
    <a class="btn ghost" href="/complaints/<%= complaint._id %>/edit">Edit complaint</a>
    <form method="POST" action="/complaints/<%= complaint._id %>/delete" onsubmit="return confirm('Delete complaint <%= complaint.complaintId %>? This cannot be undone.')">
      <button class="btn danger" type="submit" data-busy="Deleting…">Delete complaint</button>
    </form>
  </div>
<% } else if (user.role === 'student') { %>
  <p class="muted">This complaint can no longer be edited or deleted because the hostel office has started on it.</p>
<% } %>
<%- include('partials/footer') %>
