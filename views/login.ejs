<%- include('partials/header', { title: 'Log in' }) %>
<div class="card narrow">
  <h1>Log in</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="POST" action="/login">
    <label>Email <input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required></label>
    <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn" type="submit" data-busy="Logging in…">Log in</button>
  </form>
  <p class="muted">New student? <a href="/register">Create an account</a></p>
</div>
<%- include('partials/footer') %>
