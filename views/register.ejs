<%- include('partials/header', { title: 'Register' }) %>
<div class="card narrow">
  <h1>Create student account</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="POST" action="/register">
    <label>Full name <input type="text" name="name" required></label>
    <label>College email <input type="email" name="email" required></label>
    <label>Password (min 6 characters) <input type="password" name="password" required minlength="6"></label>
    <label>Hostel block
      <select name="hostel" required>
        <option value="">Choose block</option>
        <% hostels.forEach(h => { %><option><%= h %></option><% }) %>
      </select>
    </label>
    <label>Room number <input type="text" name="roomNo" placeholder="A-204"></label>
    <button class="btn" type="submit">Create account</button>
  </form>
  <p class="muted">Already registered? <a href="/login">Log in</a></p>
</div>
<%- include('partials/footer') %>
